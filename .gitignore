# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/
# .idea/ is checked in via the JetBrains-managed staged files; gitignore the
# user-specific bits only:
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/dictionaries/
.idea/dataSources/
.idea/sonarlint/

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.venv-dev/
venv/
build/
dist/

# --- Node / Next ------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
.npm/
.pnpm-store/

# --- Neural Media user data --------------------------------------------------
# These directories hold a real user's video data + inference outputs.
# NEVER commit them.
data/videos/*
!data/videos/.gitkeep
data/activations/*
!data/activations/.gitkeep
data/sqlite/*
!data/sqlite/.gitkeep
data/imports/*
!data/imports/.gitkeep
data/processed/*
!data/processed/.gitkeep

# --- Self-hosted demo clips (script-generated; third-party content) ---------
# Built by scripts/build_demo_clips.py for the "video beside the brain" feature.
# This repo is PUBLIC and these are third-party clips — never commit the media.
apps/web/public/demo-clips/*
!apps/web/public/demo-clips/.gitkeep
!apps/web/public/demo-clips/README.md

# --- Misc -------------------------------------------------------------------
*.log
coverage/
.env
.env.local
.env.*.local

# --- Internal planning docs (kept locally; not for the public-facing repo) --
neural_diet_tracker_build_plan*.pdf
