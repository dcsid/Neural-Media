# Web app — environment variables (Next.js).
#
# Copy to `.env.local` for local dev:
#   cp apps/web/.env.example apps/web/.env.local
#
# Variables prefixed `NEXT_PUBLIC_` are inlined into the client bundle at
# build time. Treat them as world-readable — never put secrets in them.
# For server-only configuration use unprefixed names (read in route
# handlers / server actions only).

# ---------------------------------------------------------------------------
# v2 single-video cloud pipeline (POST /v2/jobs flow)
# ---------------------------------------------------------------------------

# Base URL of the AWS API Gateway stage that fronts the single-video
# pipeline (jobs_create / jobs_status / hf-callback Lambdas). The web app
# concatenates `/v2/jobs[...]` onto this — no trailing slash.
#
# Local dev (sam local start-api on :3001):
#   NEXT_PUBLIC_API_BASE_V2=http://127.0.0.1:3001
# Deployed (from `sam deploy` outputs, "ApiEndpoint"):
#   NEXT_PUBLIC_API_BASE_V2=https://abc123.execute-api.us-east-1.amazonaws.com/dev
#
# Leave unset to hide the v2 single-video UI entirely (the original
# dashboard at `/` still works against the v1 SqliteStore API).
NEXT_PUBLIC_API_BASE_V2=

# ---------------------------------------------------------------------------
# v1 local-dashboard API (legacy — already wired up, listed for completeness)
# ---------------------------------------------------------------------------

# Base URL of the v1 FastAPI server (`make dev-api`, port 8000). Defaults
# to http://127.0.0.1:8000 in the web app's source if unset, so most
# contributors won't need to set this.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
